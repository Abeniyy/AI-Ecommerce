{
  "name": "ai-ecommerce-root",
  "version": "1.0.0",
  "description": "Full stack AI-enhanced ecommerce website",
  "workspaces": [
    "client",
    "server"
  ],
  "private": true,
  "scripts": {
    "preinstall": "npm install husky --no-save",
    "dev": "concurrently \"cd client && npm run dev\" \"cd server && npm run dev\"",
    "start": "cd server && npm start",
    "build": "cd client && npm run build",
    "test": "concurrently \"cd client && npm test\" \"cd server && npm test\"",
    "prepare": "husky install"
  },
  "keywords": [
    "ecommerce",
    "ai",
    "react",
    "node",
    "python"
  ],
  "author": "Abenezer Tefera <abenibah@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "concurrently": "^8.2.2",
    "husky": "^9.0.0"
  },
  "dependencies": {
    "express-rate-limit": "^8.1.0",
    "firebase": "^12.3.0",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.1.0",
    "jsdom": "^26.1.0"
  }
}
